<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Volti Registrati</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:400,700" rel="stylesheet">
    <link href="/css/grayscale.min.css" rel="stylesheet">
    <style>
        body { background: #1a1a1a; color: #eee; font-family: 'Nunito', sans-serif; }
        .page-title { text-align: center; padding: 80px 0 30px; color: #fff; }
        .page-title h2 { font-size: 2rem; font-weight: 700; }
        .page-title p { color: #aaa; }
        .faces-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 20px;
            max-width: 1100px;
            margin: 0 auto 60px;
            padding: 0 20px;
        }
        .face-card {
            background: #2a2a2a;
            border-radius: 12px;
            overflow: hidden;
            text-align: center;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .face-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.5); }
        .face-card img {
            width: 100%;
            aspect-ratio: 1;
            object-fit: cover;
        }
        .face-card .info {
            padding: 12px;
        }
        .face-card .info h5 {
            margin: 0 0 4px;
            font-weight: 700;
            text-transform: capitalize;
            color: #fff;
        }
        .face-card .info small { color: #888; }
        .empty { text-align: center; padding: 60px; color: #666; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light fixed-top" id="mainNav">
        <div class="container">
            <a class="navbar-brand js-scroll-trigger" href="/">Smart Maintenance</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/volti">Volti</a></li>
                    <li class="nav-item"><a class="nav-link" href="/dataset">Nuovo Volto</a></li>
                    <li class="nav-item"><a class="nav-link" href="/camera">Camera</a></li>
                    <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="page-title">
        <h2>Volti Registrati</h2>
        <p>{{ people | length }} identità nel sistema</p>
    </div>

    {% if people | length == 0 %}
        <div class="empty">Nessun volto registrato.</div>
    {% else %}
        <div class="faces-grid">
            {% for p in people %}
            <div class="face-card">
                <img src="{{ p.preview }}" alt="{{ p.name }}" onerror="this.src='/images/placeholder.png'">
                <div class="info">
                    <h5>{{ p.name }}</h5>
                    <small>{{ p.count }} foto</small>
                </div>
            </div>
            {% endfor %}
        </div>
    {% endif %}
</body>
</html>
